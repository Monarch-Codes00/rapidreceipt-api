{
	"info": {
		"name": "RapidReceipt API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [{"key":"Content-Type","value":"application/json"}],
						"url": {
							"raw": "http://localhost:8080/api/auth/register",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api","auth","register"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"password123\",\n    \"businessName\": \"Rapid Business\"\n}"
						}
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [{"key":"Content-Type","value":"application/json"}],
						"url": {
							"raw": "http://localhost:8080/api/auth/login",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api","auth","login"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"password123\"\n}"
						}
					}
				}
			]
		},
        {
			"name": "Profile",
			"item": [
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"header": [
							{"key":"Authorization","value":"Bearer {{token}}"}
						],
						"url": {
							"raw": "http://localhost:8080/api/profile",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api","profile"]
						}
					}
				},
                {
					"name": "Update Profile",
					"request": {
						"method": "PUT",
						"header": [
							{"key":"Content-Type","value":"application/json"},
							{"key":"Authorization","value":"Bearer {{token}}"}
						],
						"url": {
							"raw": "http://localhost:8080/api/profile",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api","profile"]
						},
                        "body": {
							"mode": "raw",
							"raw": "{\n    \"businessName\": \"Updated Rapid Business\",\n    \"phone\": \"08123456789\",\n    \"bankName\": \"Guaranty Trust Bank\",\n    \"accountNumber\": \"0123456789\",\n    \"accountName\": \"Rapid Ventures\",\n    \"brandColor\": \"#FF5733\"\n}"
						}
					}
				}
			]
		},
		{
			"name": "Customers",
			"item": [
				{
					"name": "Create Customer",
					"request": {
						"method": "POST",
						"header": [
							{"key":"Content-Type","value":"application/json"},
							{"key":"Authorization","value":"Bearer {{token}}"}
						],
						"url": {
							"raw": "http://localhost:8080/api/customers",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api","customers"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Doe\",\n    \"phone\": \"08012345678\",\n    \"email\": \"john@example.com\",\n    \"address\": \"123 Tech Street\"\n}"
						}
					}
				},
				{
					"name": "Get All Customers",
					"request": {
						"method": "GET",
						"header": [
							{"key":"Authorization","value":"Bearer {{token}}"}
						],
						"url": {
							"raw": "http://localhost:8080/api/customers",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api","customers"]
						}
					}
				}
			]
		},
		{
			"name": "Services",
			"item": [
				{
					"name": "Create Service",
					"request": {
						"method": "POST",
						"header": [
							{"key":"Content-Type","value":"application/json"},
							{"key":"Authorization","value":"Bearer {{token}}"}
						],
						"url": {
							"raw": "http://localhost:8080/api/services",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api","services"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Web Development\",\n    \"description\": \"Full stack web application\",\n    \"price\": 50000.00\n}"
						}
					}
				},
				{
					"name": "Get All Services",
					"request": {
						"method": "GET",
						"header": [
							{"key":"Authorization","value":"Bearer {{token}}"}
						],
						"url": {
							"raw": "http://localhost:8080/api/services",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api","services"]
						}
					}
				}
			]
		},
		{
			"name": "Invoices",
			"item": [
				{
					"name": "Create Invoice",
					"request": {
						"method": "POST",
						"header": [
							{"key":"Content-Type","value":"application/json"},
							{"key":"Authorization","value":"Bearer {{token}}"}
						],
						"url": {
							"raw": "http://localhost:8080/api/invoices",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api","invoices"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"customerId\": 1,\n    \"issueDate\": \"2024-05-01\",\n    \"dueDate\": \"2024-05-15\",\n    \"documentType\": \"INVOICE\",\n    \"discount\": 500.00,\n    \"items\": [\n        {\n            \"serviceName\": \"Web Development\",\n            \"quantity\": 1,\n            \"price\": 50000.00\n        }\n    ]\n}"
						}
					}
				},
				{
					"name": "Get All Invoices",
					"request": {
						"method": "GET",
						"header": [
							{"key":"Authorization","value":"Bearer {{token}}"}
						],
						"url": {
							"raw": "http://localhost:8080/api/invoices",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api","invoices"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "token",
			"value": "your_jwt_token_here"
		}
	]
}
